# Generate secrets with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Generate ENCRYPTION_KEY once, keep it forever with the existing /data volume.
# Optional legacy access: if you previously used ADMIN_TOKEN, keep it during upgrade.
# Fresh installations generate admin + a temporary eight-character password in the startup logs.
# ADMIN_TOKEN=optional-legacy-token-with-at-least-32-characters
ENCRYPTION_KEY=replace-with-exactly-64-hex-characters
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
SMTP_ENABLED=true
SMTP_HOST=0.0.0.0
SMTP_PORT=2525
SMTP_REQUIRE_TLS=true
SMTP_CERT=/data/tls/smtp.crt
SMTP_KEY=/data/tls/smtp.key
ALLOWED_SENDERS=no-reply@notify.example.org
MAX_QUEUE_DEPTH=10000
MAX_MESSAGE_BYTES=65536
MESSAGE_TTL_SECONDS=600
PROVIDER_TIMEOUT_MS=12000
WORKER_INTERVAL_MS=400
WORKER_CONCURRENCY=6
